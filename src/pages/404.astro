---
import '@fontsource/anton/latin-400.css';
import '@fontsource-variable/archivo/wght.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';
import '@club/theme.css';
import { CLUB, SEASON } from '../club';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={`${base}/escudo/favicon.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#070504" />
    <meta name="robots" content="noindex" />
    <title>Fuera de juego · {CLUB.name} {SEASON}</title>
  </head>
  <body class="bg-fondo font-sans text-claro antialiased">
    <main class="grain relative flex min-h-dvh flex-col items-center justify-center overflow-hidden px-6 text-center">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_38%,#5a3a22_0%,#1b110a_42%,#070504_76%)]"></div>
      <div class="relative">
        <img src={`${base}${CLUB.crest.src}`} alt="" width={CLUB.crest.width} height={CLUB.crest.height} class="mx-auto h-18 w-auto" />
        <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.3em] text-dorado">Error 404</p>
        <h1 class="mt-3 font-display text-6xl uppercase leading-none md:text-8xl">Fuera de juego</h1>
        <p class="mx-auto mt-4 max-w-sm text-sm text-claro/65">Esa percha está vacía: la página que buscas no existe o ha cambiado de dorsal.</p>
        <a
          href={`${base}/`}
          class="mt-8 inline-flex h-11 items-center rounded-full bg-dorado px-6 font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-fondo transition-[filter] hover:brightness-110"
        >
          Volver al vestuario
        </a>
      </div>
      <footer class="absolute inset-x-0 bottom-0 px-4 pb-4 text-left md:px-8">
        <p class="text-xs text-zinc-500">© 2026 · Tributo no oficial de un aficionado</p>
        {/* Crédito Bellostas Studio */}
        <a
          href="https://bellostas.studio"
          target="_blank"
          rel="noopener"
          class="group mt-1.5 inline-flex items-center gap-1.5 text-xs text-zinc-500 transition-colors hover:text-white"
          aria-label="Web diseñada y desarrollada por Bellostas Studio"
        >
          <span>Diseñado y desarrollado por</span>
          <span class="relative font-semibold tracking-tight text-zinc-400 transition-colors group-hover:text-white">
            Bellostas Studio
            <span class="absolute -bottom-0.5 left-0 right-0 h-px origin-left scale-x-0 bg-acento-vivo transition-transform duration-300 group-hover:scale-x-100"></span>
          </span>
        </a>
      </footer>
    </main>
  </body>
</html>
